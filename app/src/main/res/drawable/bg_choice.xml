<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF1565C0"/>
            <corners android:radius="20dp"/>
            <stroke android:width="8dp" android:color="#FFFFEB3B"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF1565C0"/>
            <corners android:radius="20dp"/>
            <stroke android:width="8dp" android:color="#FFFFEB3B"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF0D47A1"/>
            <corners android:radius="20dp"/>
            <stroke android:width="6dp" android:color="#FFFFF59D"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1B2838"/>
            <corners android:radius="20dp"/>
            <stroke android:width="2dp" android:color="#FF455A64"/>
        </shape>
    </item>
</selector>